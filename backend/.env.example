# Server
PORT=3000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (Vite dev servers)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Public base URL of this API. Only used as a fallback for legacy local
# image links (see "File uploads" below) — leave blank locally.
BACKEND_PUBLIC_URL=

# Cloudinary — every vehicle photo (admin-uploaded or one of the default
# seeded ones) is stored here; only the absolute secure_url it returns is
# saved in MongoDB, so images always work from any origin (frontend, admin
# panel, emails) with no local file storage involved. Get this from your
# Cloudinary dashboard: https://console.cloudinary.com/ → Dashboard → API
# Environment variable (format: cloudinary://<api_key>:<api_secret>@<cloud_name>)
CLOUDINARY_URL=

# Admin login (used by the /admin dashboard) — change these before deploying!
ADMIN_EMAIL=admin@salamcab.com
ADMIN_PASSWORD=SalamCab@123
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=1d

# MongoDB
# Local example:  mongodb://127.0.0.1:27017/salam-cab
# Atlas example:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/salam-cab
MONGODB_URI=mongodb://127.0.0.1:27017/salam-cab

# SMTP (booking confirmation emails)
# Leave these blank during local development and the server will
# automatically create a free Ethereal test inbox instead — a preview
# link for every email is printed in the server console, so the
# full booking -> email flow can be demoed without any real mailbox.
#
# To send real emails, fill these in, e.g. Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=Salam Cab
MAIL_FROM_ADDRESS=admin@salamcabs.com

# WhatsApp OTP (booking phone verification)
# Leave WHATSAPP_OTP_MOCK=true locally — codes are logged to the server console
# and returned in the API response for demo purposes. Set to false in production
# once Meta WhatsApp Cloud API credentials and an approved template are ready.
WHATSAPP_OTP_MOCK=true
OTP_REQUIRED=true
OTP_JWT_SECRET=
OTP_JWT_EXPIRES_IN=15m
OTP_LENGTH=4
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Meta WhatsApp Cloud API — get these from developers.facebook.com
# Dashboard → Your App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_OTP_TEMPLATE_NAME=salam_cab_otp
WHATSAPP_OTP_TEMPLATE_LANG=en
